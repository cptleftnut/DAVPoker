{
  "name": "davpoker-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "description": "DAVPoker - AI-Powered Poker Decision Engine for Android",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --non-interactive",
    "build:android:release": "eas build --platform android --non-interactive --release",
    "submit:android": "eas submit --platform android --non-interactive",
    "test": "jest"
  },
  "npmrc": {
    "legacy-peer-deps": true
  },
  "license": "MIT",
  "author": "DAVPoker Team",
  "dependencies": {
    "expo": "^50.0.0",
    "expo-camera": "^14.0.0",
    "expo-status-bar": "^1.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-screens": "^3.27.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/stack": "^6.3.0",
    "axios": "^1.6.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "typescript": "^5.2.0"
  },
  ".npmrc": {
    "legacy-peer-deps": true
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
